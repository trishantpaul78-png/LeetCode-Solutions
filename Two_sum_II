class Solution:
    def twoSum(self, numbers: List[int], target: int) -> List[int]:
        l = 0
        r = len(numbers) - 1

        while l < r:
            current_sum = numbers[l] + numbers[r]

            if current_sum == target:
                return [l + 1, r + 1] # Fixed for 1-based indexing
            
            elif current_sum < target:
                l += 1 # Sum is too small, move to a bigger value
                
            else:
                r -= 1 # Sum is too big, move to a smaller value
                